{
  "name": "thug2-level-converter-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "THUG2 Level Converter Core: THUG2's formats and what the THUG2 level converters share (TypeScript, Node 24).",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CanuckAussieKev/thug2-level-converter-core.git"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*.ts": {
      "types": "./*.ts",
      "default": "./*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "node --test \"**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
